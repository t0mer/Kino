# Copy to .env and fill in. Every setting is optional unless marked REQUIRED.
# Precedence: environment (this file) > /data/config.yaml > built-in defaults.

# --- Paths -------------------------------------------------------------------
KINO_DATA_DIR=/data
KINO_PHOTOS_DIR=/data/photos
# Built web UI served by `kino api`. The image ships it at this path; leave it unset
# unless you serve a custom build. If the directory is missing, only the API is served.
#KINO_WEB_DIR=/opt/venv/share/kino/web

# --- OpenWA ------------------------------------------------------------------
KINO_OPENWA_URL=http://openwa:2785
# Needed by the api, forward-worker and CLI OpenWA commands
KINO_OPENWA_API_KEY=
# The single OpenWA session Kino listens to; webhooks from other sessions are rejected
KINO_OPENWA_SESSION_ID=
# REQUIRED. HMAC secret shared with OpenWA (16+ chars). Generate with: openssl rand -hex 32
KINO_WEBHOOK_SECRET=

# --- Auth (web UI) -------------------------------------------------------------
# First run: with no password hash set, open the UI from your LAN (not through a tunnel)
# and choose the admin password on the setup page. It is stored (argon2) in the database.
# Alternatively pre-set an argon2 hash here; it takes precedence over the setup page.
KINO_ADMIN_USER=admin
KINO_ADMIN_PASSWORD_HASH=
# Expose /metrics without authentication (default false)
KINO_METRICS_PUBLIC=false

# --- Models and detection ----------------------------------------------------
# auraface (Apache-2.0, default) | buffalo_l (non-commercial research use only)
KINO_EMBEDDER=auraface
# Detector input size for the full-image pass; multiple of 32
KINO_DET_SIZE=1024
# off | auto | always
KINO_TILING=auto
# 2x2 | 3x3 | auto
KINO_TILE_GRID=auto
KINO_TILE_OVERLAP=0.2

# --- Workers -----------------------------------------------------------------
KINO_WORKERS=2
KINO_ORT_THREADS=2
KINO_FORWARD_RATE_PER_MIN=6

# --- Saving and privacy ------------------------------------------------------
# Remove GPS EXIF from saved (and forwarded) photos
KINO_STRIP_GPS=true
# IANA time zone for photo folders/filenames and EXIF local time
KINO_TIMEZONE=UTC

# --- Accepted but not used in M1 (retention cleanup, burst, digest come later) -
KINO_RAW_RETENTION_DAYS=7
KINO_FACE_RETENTION_DAYS=30
KINO_BURST_ENABLED=false
KINO_DIGEST_CRON=0 20 * * *
KINO_APPRISE_URLS=

# --- Logging -----------------------------------------------------------------
KINO_LOG_LEVEL=INFO
KINO_LOG_JSON=false
